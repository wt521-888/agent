# ==============================================
# 简历智能打分 Agent - 环境变量模板
# ==============================================
# 复制此文件为 .env 并填入真实值

# OpenAI / 兼容服务（使用小米 MiMo）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.xiaomimimo.com/v1
OPENAI_MODEL=mimo-v2.5-pro

# 视觉模型（负责图片型 PDF OCR）
# 注意：mimo-v2.5-pro 不支持图片输入，视觉端点必须用 mimo-v2.5
VISION_MODEL=mimo-v2.5

# Tavily 搜索
TAVILY_API_KEY=tvly-your-api-key-here

# SQLite 数据库
DATABASE_URL=sqlite:///./resume_agent.db

# 上传文件存储目录
UPLOAD_DIR=uploads

# 联网搜索条数
MAX_SEARCH_RESULTS=5

# LiteParse OCR 设置（可选）
# 启用 OCR 可识别扫描件，但需要网络下载 Tesseract 数据
# LITEPARSE_OCR_ENABLED=false
# LITEPARSE_OCR_LANG=chi_sim+eng
